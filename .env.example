# ---------------------------------------------------------------------------
# Vionex Projects — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string used by Prisma.
DATABASE_URL="postgresql://vionex:CHANGE_ME@localhost:5433/vionex_projects?schema=public"

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Public origin of the application (used for absolute links in notifications).
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Document storage
# STORAGE_DRIVER=local  -> files are written to STORAGE_LOCAL_DIR (development)
# STORAGE_DRIVER=s3     -> files are written to an S3-compatible bucket
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="vionex-projects-documents"
STORAGE_FORCE_PATH_STYLE="false"

# Maximum upload size in megabytes.
UPLOAD_MAX_SIZE_MB="25"

# ---------------------------------------------------------------------------
# Outbound e-mail (reserved for future notification delivery — see docs)
# ---------------------------------------------------------------------------
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Vionex Projects <no-reply@vionex.com>"
