# ---------------------------------------------------------------------------
# Vionex Projects — environment configuration
# Copy to `.env` and fill in real values. Never commit `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection used by the application.
# On a managed provider, use the POOLED connection string (transaction mode).
DATABASE_URL="postgresql://vionex:CHANGE_ME@localhost:5433/vionex_projects?schema=public"

# Direct (non-pooled) connection, used only by `prisma migrate`.
# Leave empty for a local database; required on providers that pool, because
# migrations need session-level advisory locks a transaction pooler lacks.
# Supabase example: postgresql://postgres:PASSWORD@db.PROJECT.supabase.co:5432/postgres
DIRECT_URL=""

# Secret used to sign session cookies. Generate with: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME_generate_with_openssl_rand_base64_32"

# Public origin of the application. Must be https in production — the session
# cookie is Secure, so the app refuses to boot with http.
APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Document storage
# STORAGE_DRIVER=local  -> files are written to STORAGE_LOCAL_DIR (development)
# STORAGE_DRIVER=s3     -> files are written to an S3-compatible bucket
#
# `local` is REFUSED in production: serverless and container filesystems are
# ephemeral, so uploads would succeed and then silently disappear.
#
# Supabase Storage is S3-compatible; point STORAGE_ENDPOINT at
# https://PROJECT.supabase.co/storage/v1/s3 and set FORCE_PATH_STYLE=true.
# ---------------------------------------------------------------------------
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="./storage"

STORAGE_ENDPOINT="https://s3.us-east-1.amazonaws.com"
STORAGE_REGION="us-east-1"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_BUCKET="vionex-projects-documents"
STORAGE_FORCE_PATH_STYLE="false"

# Maximum upload size in megabytes.
UPLOAD_MAX_SIZE_MB="25"

# ---------------------------------------------------------------------------
# Demonstration mode
#
# This build ships with the account chooser at /demo always open: anyone who
# reaches the URL can sign in as any seeded user, with no password. It needs no
# variable — see src/lib/demo.ts.
#
# Before the platform holds real supplier data, `isDemoEnabled()` in that file
# must return false outside development. The login flow is untouched and stays
# reachable at /login.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Outbound e-mail (reserved for future notification delivery — see docs)
# ---------------------------------------------------------------------------
EMAIL_SERVER="smtp://user:password@smtp.example.com:587"
EMAIL_FROM="Vionex Projects <no-reply@vionex.com>"
