// Vionex Projects — International Projects Management Platform
// Multi-tenant schema. Every tenant-scoped record carries `organizationId`;
// supplier-facing records additionally carry `supplierId` so that isolation
// can be enforced with a single indexed predicate on the server.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  MANAGER
  REGULATORY
  IMPORT
  MARKETING
  VIEWER
  SUPPLIER_ADMIN
  SUPPLIER_USER
}

enum UserStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum Language {
  PT_BR
  EN
  ZH
}

enum StageKey {
  CLINICAL
  REGULATORY
  IMPORT_LOGISTICS
  GO_TO_MARKET
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskCategory {
  CLINICAL
  REGULATORY
  IMPORT
  GO_TO_MARKET
  GENERAL
}

enum DocumentType {
  CONTRACT
  NDA
  CERTIFICATE
  IFU
  CLINICAL
  REGULATORY
  PRESENTATION
  IMPORT
  COMMERCIAL
  OTHER
}

/// Controls whether a document is visible inside the Supplier Portal.
enum DocumentVisibility {
  INTERNAL_ONLY
  SHARED_WITH_SUPPLIER
}

/**
 * What a reviewer decided, as opposed to where the request currently stands.
 * Deliberately not `RequestStatus`. That enum answers "where is this now" and
 * carries PENDING, SUBMITTED, IN_REVIEW and CANCELLED — none of which is a
 * verdict, and all of which would be representable as one if the two shared a
 * type. A review row saying `decision: PENDING` is nonsense the database would
 * happily store.
 * `CHANGES_REQUESTED` rather than `REJECTED` because that is what the act is:
 * the supplier is expected to come back. `DocumentRequest.status` keeps
 * `REJECTED` — changing a legacy enum value to rename a concept would rewrite
 * history for no gain.
 */
enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
}

/**
 * Health of a project or a supplier relationship — replaces `ProjectStatus`
 * and `SupplierStatus`, which were the same four words (ON_TRACK, AT_RISK,
 * BLOCKED) with a different fourth value each (COMPLETED vs INACTIVE). A pure
 * union: every value either type already had keeps its exact spelling, and
 * neither model uses a value that was not already legal for it.
 */
enum HealthStatus {
  ON_TRACK
  AT_RISK
  BLOCKED
  COMPLETED
  INACTIVE
}

/**
 * Where a document, a regulatory item or a document request stands — replaces
 * `DocumentStatus`, `RegulatoryItemStatus` (byte-identical to it) and
 * `RequestStatus` (four of its six values already matched). A pure union of
 * the three: no value is renamed, so every stored row keeps the exact word it
 * already had, and each model still only ever writes the subset it always did
 * (`Document.status`, for instance, has never actually stored `PENDING` or
 * `REQUESTED` — see `src/server/services/documents.ts` — but the value stays
 * declared rather than pruned, matching what `DocumentStatus` always allowed).
 * `RECEIVED` (the word `Document`/`RegulatoryItem` use for "something arrived")
 * and `SUBMITTED` (the word `DocumentRequest` uses for the same event) are
 * deliberately both kept rather than merged into one spelling — which of the
 * two words is right is a product-copy decision, not a schema one, and is left
 * open in `docs/product-freeze/` rather than decided here.
 */
enum DocumentCycleStatus {
  PENDING
  REQUESTED
  RECEIVED
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  CANCELLED
}

/**
 * How a piece of work is coming along — replaces `StageStatus`, `GtmItemStatus`
 * (identical to it), `MilestoneStatus`, `ClinicalStudyStatus` and `TaskStatus`.
 * A pure union of all five: nothing is renamed or merged, so every existing row
 * keeps its exact stored word.
 * `NOT_STARTED` (stage/GTM item), `PLANNED` (milestone/clinical study) and
 * `OPEN` (task) all mean the same thing — work that has not begun — but are
 * kept as three separate values rather than collapsed into one spelling, for
 * the same reason `RECEIVED`/`SUBMITTED` above were: several of the words in
 * this vocabulary carry Portuguese grammatical gender that agrees with the
 * noun they describe (`Não iniciad**a**` for a etapa, `Não iniciad**o**` for
 * an item, `Abert**a**` for a tarefa), so a single shared spelling cannot
 * serve all five without either breaking that agreement or a larger i18n
 * change than this round is authorised to make. The same restraint applies to
 * `BLOCKED` (stage/GTM item), `DELAYED` (milestone), `SUSPENDED` (clinical
 * study) and `WAITING` (task): each names a real, distinguishable way work
 * stalls, and a regulated medical-device business is exactly the kind of
 * place where quietly conflating "a supplier is blocking this" with "an
 * ethics committee suspended this clinical study" would be a mistake, not a
 * simplification.
 */
enum ProgressStatus {
  NOT_STARTED
  PLANNED
  OPEN
  IN_PROGRESS
  WAITING
  BLOCKED
  DELAYED
  SUSPENDED
  COMPLETED
  CANCELLED
}

enum ShipmentStage {
  PRODUCTION
  READY_FOR_SHIPMENT
  SHIPPED
  IN_TRANSIT
  ARRIVED
  CUSTOMS
  DELIVERED
}

enum GtmCategory {
  MARKET_ANALYSIS
  COMMERCIAL_STRATEGY
  PRICING
  SALES_CHANNELS
  KOLS
  MARKETING
  TRAINING
  LAUNCH_PLAN
}

enum TimelineEventType {
  PROJECT_CREATED
  PROJECT_UPDATED
  STATUS_CHANGED
  STAGE_UPDATED
  TASK_CREATED
  TASK_UPDATED
  TASK_COMPLETED
  COMMENT_ADDED
  DOCUMENT_UPLOADED
  DOCUMENT_REQUESTED
  DOCUMENT_SUBMITTED
  DOCUMENT_REVIEWED
  MESSAGE_SENT
  MILESTONE_REACHED
}

enum NotificationType {
  TASK_ASSIGNED
  TASK_DUE_SOON
  TASK_OVERDUE
  DOCUMENT_REQUESTED
  DOCUMENT_RECEIVED
  DOCUMENT_REVIEWED
  COMMENT_ADDED
  MESSAGE_RECEIVED
  PROJECT_UPDATED
  SUPPLIER_REPLIED
}

// ---------------------------------------------------------------------------
// Tenancy & identity
// ---------------------------------------------------------------------------

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users     User[]
  suppliers Supplier[]
  projects  Project[]
  documents Document[]
  tasks     Task[]
  auditLogs AuditLog[]
}

model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  name           String
  country        String
  website        String?
  address        String?
  primaryContact String?
  email          String?
  phone          String?
  status         HealthStatus @default(ON_TRACK)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]
  projects     Project[]
  tasks        Task[]
  documents    Document[]
  requests     DocumentRequest[]

  @@unique([organizationId, name])
  @@index([organizationId, status])
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  supplierId     String?
  name           String
  email          String     @unique
  passwordHash   String
  role           UserRole
  jobTitle       String?
  department     String?
  language       Language   @default(PT_BR)
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: Cascade)

  ownedProjects     Project[]               @relation("ProjectOwner")
  assignedTasks     Task[]                  @relation("TaskAssignee")
  createdTasks      Task[]                  @relation("TaskCreator")
  comments          TaskComment[]
  uploadedDocuments Document[]              @relation("DocumentCreator")
  documentVersions  DocumentVersion[]
  requestedDocs     DocumentRequest[]       @relation("RequestAuthor")
  requestReplies    DocumentRequestReply[]  @relation("RequestReplyAuthor")
  documentReviews   DocumentRequestReview[] @relation("RequestReviewer")
  timelineEvents    TimelineEvent[]
  notifications     Notification[]
  messages          Message[]
  messageReads      MessageRead[]
  auditLogs         AuditLog[]

  @@index([organizationId, role])
  @@index([supplierId])
}

// ---------------------------------------------------------------------------
// Projects
// ---------------------------------------------------------------------------

model Project {
  id               String       @id @default(cuid())
  organizationId   String
  supplierId       String
  ownerId          String
  name             String
  projectCode      String
  description      String?
  country          String
  productType      String?
  category         String?
  status           HealthStatus @default(ON_TRACK)
  currentStage     StageKey     @default(CLINICAL)
  blockerNote      String?
  startDate        DateTime?
  targetLaunchDate DateTime?
  archivedAt       DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier     @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  owner        User         @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Restrict)

  stages          ProjectStage[]
  tasks           Task[]
  documents       Document[]
  requests        DocumentRequest[]
  milestones      Milestone[]
  clinicalStudy   ClinicalStudy?
  regulatoryItems RegulatoryItem[]
  shipments       ImportShipment[]
  gtmItems        GtmItem[]
  threads         MessageThread[]
  timeline        TimelineEvent[]

  @@unique([organizationId, projectCode])
  @@index([organizationId, status])
  @@index([supplierId])
  @@index([ownerId])
}

model ProjectStage {
  id        String         @id @default(cuid())
  projectId String
  key       StageKey
  name      String
  position  Int
  status    ProgressStatus @default(NOT_STARTED)
  /// Manual progress override, 0–100. When null, progress is derived from tasks.
  progress  Int?
  startDate DateTime?
  dueDate   DateTime?
  notes     String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, key])
  @@index([projectId])
}

model Milestone {
  id          String         @id @default(cuid())
  projectId   String
  title       String
  description String?
  stage       StageKey?
  dueDate     DateTime?
  status      ProgressStatus @default(PLANNED)
  position    Int            @default(0)
  completedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

// ---------------------------------------------------------------------------
// Tasks
// ---------------------------------------------------------------------------

model Task {
  id             String         @id @default(cuid())
  organizationId String
  projectId      String
  assignedToId   String?
  createdById    String
  /// Supplier the task is waiting on. Also grants that supplier read access.
  supplierId     String?
  title          String
  description    String?
  category       TaskCategory   @default(GENERAL)
  priority       TaskPriority   @default(MEDIUM)
  status         ProgressStatus @default(OPEN)
  dueDate        DateTime?
  completedAt    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  createdBy    User         @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  supplier     Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)

  comments TaskComment[]
  requests DocumentRequest[]

  @@index([organizationId, status])
  @@index([projectId])
  @@index([assignedToId])
  @@index([supplierId])
  @@index([dueDate])
}

model TaskComment {
  id        String   @id @default(cuid())
  taskId    String
  authorId  String
  body      String
  /// Internal notes are never exposed to the Supplier Portal.
  internal  Boolean  @default(true)
  createdAt DateTime @default(now())

  task   Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([taskId])
}

// ---------------------------------------------------------------------------
// Documents
// ---------------------------------------------------------------------------

model Document {
  id               String              @id @default(cuid())
  organizationId   String
  projectId        String
  supplierId       String?
  createdById      String
  currentVersionId String?             @unique
  name             String
  type             DocumentType        @default(OTHER)
  status           DocumentCycleStatus @default(RECEIVED)
  visibility       DocumentVisibility  @default(INTERNAL_ONLY)
  notes            String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project        Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier       Supplier?        @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  createdBy      User             @relation("DocumentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  currentVersion DocumentVersion? @relation("CurrentVersion", fields: [currentVersionId], references: [id], onDelete: SetNull)

  versions DocumentVersion[] @relation("DocumentVersions")
  requests DocumentRequest[]

  @@index([organizationId, type])
  @@index([projectId])
  @@index([supplierId, visibility])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  uploadedById String
  version      Int
  /// Opaque storage key resolved by the storage driver — never a public URL.
  storageKey   String
  fileName     String
  fileSize     Int
  mimeType     String
  checksum     String?
  createdAt    DateTime @default(now())

  document   Document @relation("DocumentVersions", fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id], onDelete: Restrict)

  currentOf Document? @relation("CurrentVersion")

  reviews     DocumentRequestReview[]
  attachments MessageAttachment[]

  @@unique([documentId, version])
  @@index([documentId])
}

model DocumentRequest {
  id            String              @id @default(cuid())
  projectId     String
  supplierId    String
  requestedById String
  documentId    String?
  taskId        String?
  title         String
  description   String?
  type          DocumentType        @default(OTHER)
  status        DocumentCycleStatus @default(PENDING)
  dueDate       DateTime?
  submittedAt   DateTime?
  reviewedAt    DateTime?
  reviewNote    String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  supplier    Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  requestedBy User      @relation("RequestAuthor", fields: [requestedById], references: [id], onDelete: Restrict)
  document    Document? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  task        Task?     @relation(fields: [taskId], references: [id], onDelete: SetNull)

  replies DocumentRequestReply[]
  reviews DocumentRequestReview[]

  @@index([supplierId, status])
  @@index([projectId])
}

model DocumentRequestReply {
  id        String   @id @default(cuid())
  requestId String
  authorId  String
  body      String
  createdAt DateTime @default(now())

  request DocumentRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  /**
   * The relation this column always implied.
   * `authorId` was written from the first day and never constrained, so the
   * screen showed anonymous messages and nothing stopped a reply pointing at a
   * user that had ceased to exist.
   * `Restrict`, matching every other authorship link in this schema
   * (`Task.createdById`, `Document.createdById`, `DocumentVersion.uploadedById`,
   * `DocumentRequest.requestedById`). Accounts here are suspended, not deleted,
   * precisely so a regulatory exchange stays attributable — a cascade would
   * erase the supplier's answer along with the account of whoever typed it.
   */
  author User @relation("RequestReplyAuthor", fields: [authorId], references: [id], onDelete: Restrict)

  @@index([requestId])
  @@index([authorId])
}

/**
 * One round of review on a document request.
 * `DocumentRequest.reviewNote` holds the *current* verdict and is overwritten
 * by the next one, which is right for a field answering "where does this
 * stand" and useless as a record: in a reject → resubmit → reject sequence the
 * first reason was gone. The note has been preserved in the request's
 * conversation since PC-2, which keeps it readable; this keeps it *queryable* —
 * who decided what, on which file, and when.
 * Written inside the same transaction as the decision, so a request cannot end
 * up approved with no review, or reviewed while its status says otherwise.
 */
model DocumentRequestReview {
  id                String         @id @default(cuid())
  requestId         String
  /// The exact file that was judged. Null when the supplier answered with only
  /// a message, which is a legitimate round.
  documentVersionId String?
  reviewerId        String
  decision          ReviewDecision
  /// What the supplier is told. Shared verbatim — there is no internal note here.
  note              String?
  createdAt         DateTime       @default(now())

  request         DocumentRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion? @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)
  reviewer        User             @relation("RequestReviewer", fields: [reviewerId], references: [id], onDelete: Restrict)

  @@index([requestId, createdAt])
  @@index([reviewerId])
  @@index([documentVersionId])
}

// ---------------------------------------------------------------------------
// Stage detail records
// ---------------------------------------------------------------------------

model ClinicalStudy {
  id                 String         @id @default(cuid())
  projectId          String         @unique
  institution        String?
  country            String?
  protocol           String?
  studyType          String?
  status             ProgressStatus @default(PLANNED)
  startDate          DateTime?
  expectedCompletion DateTime?
  notes              String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
}

model RegulatoryItem {
  id            String              @id @default(cuid())
  projectId     String
  title         String
  authority     String?
  requestedFrom String?
  ownerName     String?
  status        DocumentCycleStatus @default(PENDING)
  dueDate       DateTime?
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, status])
}

model ImportShipment {
  id             String        @id @default(cuid())
  projectId      String
  reference      String?
  stage          ShipmentStage @default(PRODUCTION)
  shippingMethod String?
  carrier        String?
  trackingNumber String?
  portOfOrigin   String?
  portOfArrival  String?
  etd            DateTime?
  eta            DateTime?
  arrivedAt      DateTime?
  productionNote String?
  documentsNote  String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
}

model GtmItem {
  id        String         @id @default(cuid())
  projectId String
  category  GtmCategory
  title     String
  detail    String?
  owner     String?
  status    ProgressStatus @default(NOT_STARTED)
  dueDate   DateTime?
  position  Int            @default(0)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId, category])
}

// ---------------------------------------------------------------------------
// Messaging, timeline, notifications, audit
// ---------------------------------------------------------------------------

model MessageThread {
  id           String   @id @default(cuid())
  projectId    String
  subject      String
  /// Threads visible to the supplier are the shared Vionex ↔ supplier channel.
  withSupplier Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages Message[]

  @@index([projectId])
}

model Message {
  id        String   @id @default(cuid())
  threadId  String
  senderId  String
  body      String
  createdAt DateTime @default(now())

  thread MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender User          @relation(fields: [senderId], references: [id], onDelete: Cascade)

  reads       MessageRead[]
  attachments MessageAttachment[]

  @@index([threadId, createdAt])
}

/**
 * A file attached to a message.
 * It points at a `DocumentVersion` rather than carrying a file of its own, and
 * that is the whole design. The platform already has exactly one way a stored
 * file reaches a browser — `/api/files/[versionId]`, which revalidates the
 * session, re-applies the caller's scope and writes the download to the audit
 * log. A second path would mean a second authorisation to keep correct, and
 * two authorisations eventually disagree.
 * The **version**, not the document: an attachment is the file as it was sent.
 * A later version of the same document must not retroactively change what
 * somebody received.
 * Visibility follows the thread. A file attached to a thread shared with a
 * supplier is created `SHARED_WITH_SUPPLIER`, so `documentScope` lets them
 * download it; one attached to an internal thread stays `INTERNAL_ONLY`, and
 * the thread itself is already invisible to them.
 */
model MessageAttachment {
  id                String   @id @default(cuid())
  messageId         String
  documentVersionId String
  createdAt         DateTime @default(now())

  message         Message         @relation(fields: [messageId], references: [id], onDelete: Cascade)
  documentVersion DocumentVersion @relation(fields: [documentVersionId], references: [id], onDelete: Restrict)

  /// A double-submitted send cannot attach the same file twice.
  @@unique([messageId, documentVersionId])
  @@index([documentVersionId])
}

model MessageRead {
  id        String   @id @default(cuid())
  messageId String
  userId    String
  readAt    DateTime @default(now())

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([messageId, userId])
  @@index([userId])
}

model TimelineEvent {
  id          String            @id @default(cuid())
  projectId   String
  actorId     String?
  type        TimelineEventType
  description String
  /// Events flagged internal are hidden from the Supplier Portal timeline.
  internal    Boolean           @default(false)
  metadata    Json?
  createdAt   DateTime          @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actor   User?   @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([projectId, createdAt])
}

model Notification {
  id          String           @id @default(cuid())
  userId      String
  type        NotificationType
  title       String
  description String?
  /// Relative in-app path the notification points to.
  href        String?
  readAt      DateTime?
  createdAt   DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
}

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String
  actorId        String?
  action         String
  entity         String
  entityId       String
  metadata       Json?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor        User?        @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([entity, entityId])
}

/// Failed sign-in attempts, used to throttle credential stuffing.
///
/// Kept in the database rather than in process memory: on any horizontally
/// scaled or serverless deployment an in-memory counter is per-instance, so an
/// attacker simply spreads attempts across instances and the limit never trips.
model LoginAttempt {
  id        String   @id @default(cuid())
  /// Either "email:<address>" or "ip:<address>" — both are throttled.
  key       String
  createdAt DateTime @default(now())

  @@index([key, createdAt])
  @@index([createdAt])
}
