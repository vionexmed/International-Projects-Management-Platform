# Dependencies
/node_modules
/.pnp
.pnp.*

# Next.js
/.next/
/out/
/build
next-env.d.ts

# Environment — secrets never get versioned, but the template does.
.env
.env.*
!.env.example

# Local development database cluster (scripts/local-db.mjs)
/.postgres

# Documents written by the local storage driver
/storage

# Generated Prisma client
/src/generated

# Testing
/coverage

# TypeScript
*.tsbuildinfo

# Vercel
.vercel

# Editor / OS
.DS_Store
*.pem

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Generated demo database snapshot (built by `npm run demo:snapshot`)
/src/server/demo/snapshot

# Local state of the claude-flow tooling: session logs (which embed absolute
# paths from whichever machine ran them), neural caches, policy state. Nothing
# in the product reads it and it grows every session, so it is not part of the
# checkpoint. Kept on disk, just not versioned — if real configuration ever
# lands here, un-ignore that file explicitly.
/.claude-flow/
